# ── NORIA ENGINE — environment template ──────────────────────────────────────
# Copy to .env for local dev, or set these in Render → Environment for production.
# NEVER commit real keys.

# ── Core ──────────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:pass@host/db      # Neon / Render Postgres (pgvector)
NORIA_SETUP_SECRET=change-me                    # protects /v1/setup and diagnostics
ALLOWED_ORIGINS=https://your-noria-site         # comma-separated; * = allow all (dev)

# ── LLM providers (free tier) ─────────────────────────────────────────────────
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# Optional model overrides (defaults track current live models):
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# GEMINI_MODEL=gemini-3.5-flash-lite

# ── Accounts ──────────────────────────────────────────────────────────────────
JWT_SECRET=                                     # long random string; required for auth
JWT_TTL=30d

# ── Billing — NORIA Pro, weekly or monthly, via Paystack and/or Paddle ────────
# Configure either provider (or both — whichever has keys set is offered to
# the user). See MONETIZATION.md for exact dashboard click-through steps.

# Paystack (cards / mobile money / bank / USSD — best for Africa)
PAYSTACK_SECRET_KEY=                            # sk_live_… / sk_test_…
PAYSTACK_PUBLIC_KEY=                            # pk_live_… / pk_test_…
PAYSTACK_PLAN_PRO_WEEKLY=                       # PLN_… (weekly Pro plan code)
PAYSTACK_PLAN_PRO_MONTHLY=                      # PLN_… (monthly Pro plan code)
PAYWALL_CALLBACK_URL=                           # where Paystack returns the user after paying

# Paddle (cards / wallets globally — Paddle is merchant-of-record and handles
# VAT/sales tax for you)
PADDLE_API_KEY=                                 # server-side API key (Developer Tools → Authentication)
PADDLE_CLIENT_TOKEN=                            # public token for Paddle.js (safe to expose to the frontend)
PADDLE_WEBHOOK_SECRET=                          # Notifications → your webhook destination → secret key
PADDLE_ENVIRONMENT=sandbox                      # 'sandbox' while testing, 'production' when live
PADDLE_PRICE_PRO_WEEKLY=                        # pri_… (weekly Pro price id)
PADDLE_PRICE_PRO_MONTHLY=                       # pri_… (monthly Pro price id)

PAYWALL_ENABLED=false                           # set true to enforce the paywall

# ── Premium AI model (for Premium subscribers) ────────────────────────────────
PREMIUM_API_KEY=                                # e.g. an OpenRouter key
PREMIUM_BASE_URL=https://openrouter.ai/api/v1/chat/completions
PREMIUM_MODEL=openai/gpt-4o-mini
# PREMIUM_FALLBACK_MODEL=
